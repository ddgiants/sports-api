APP_ENV=development
RUN_MIGRATIONS=true
DATABASE_URL=mysql+asyncmy://sports:sports@127.0.0.1:3307/sports
ESPN_BASE_URL=https://site.web.api.espn.com/apis/site/v2/sports
ESPN_TIMEOUT_SECONDS=20
ESPN_MAX_RETRIES=3
ESPN_CONCURRENCY=5
ESPN_NEWS_LIMIT=50
ESPN_TEAM_LIMIT=1000
ESPN_USER_AGENT=sports-api/1.0
# The Gist uses eng.1 and usa.1 as its soccer examples. Add any ESPN league slugs.
ESPN_SOCCER_LEAGUES=eng.1,usa.1
ESPN_INCLUDE_TEAM_DETAILS=true
# true makes any individual team/summary failure abort that league snapshot
ESPN_STRICT_SYNC=false
CORS_ORIGINS=
